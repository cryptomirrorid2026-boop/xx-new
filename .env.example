# ================================
#   DISCORD TO TELEGRAM MIRROR BOT
#   Salin file ini menjadi .env
#   dan isi dengan token Anda
# ================================

# ─── DISCORD ───────────────────────────────────────────────────────────────────
# Token bot Discord Anda
# Dapatkan di: https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# ─── TELEGRAM ──────────────────────────────────────────────────────────────────
# Token bot Telegram Anda
# Dapatkan dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ─── KONFIGURASI MAPPING ───────────────────────────────────────────────────────
# Format: DISCORD_CHANNEL_ID_1:TELEGRAM_CHAT_ID_1,DISCORD_CHANNEL_ID_2:TELEGRAM_CHAT_ID_2
# Chat ID Telegram bisa berupa grup (-100xxx) atau user pribadi (positif)
# Contoh: 123456789012345678:-1001234567890,987654321098765432:-1009876543210
CHANNEL_MAPPING=DISCORD_CHANNEL_ID:TELEGRAM_CHAT_ID

# ─── PENGATURAN BOT ────────────────────────────────────────────────────────────
# Nama watermark yang muncul di setiap pesan yang diteruskan
WATERMARK=🔄 Discord Mirror

# Forward pesan dari bot lain? (true/false)
FORWARD_BOT_MESSAGES=false

# Forward pesan yang diedit? (true/false)  
FORWARD_EDITS=true

# Tampilkan nama channel Discord di pesan? (true/false)
SHOW_CHANNEL_NAME=true

# Tampilkan nama server Discord di pesan? (true/false)
SHOW_SERVER_NAME=true

# Tampilkan nama pengirim? (true/false)
SHOW_AUTHOR_NAME=true

# ─── FILTER ────────────────────────────────────────────────────────────────────
# Kata-kata yang diblacklist (pisahkan dengan koma), pesan yang mengandung
# kata ini tidak akan diteruskan. Kosongkan jika tidak ada filter.
BLACKLIST_WORDS=

# Panjang pesan maksimum yang diteruskan (karakter), 0 = tidak dibatasi
MAX_MESSAGE_LENGTH=4000

# ─── MEMORY & STABILITY GUARD ──────────────────────────────────────────────────
# Batas maksimal penggunaan RAM (MB) sebelum bot melakukan auto-restart mandiri via PM2
MAX_RAM_MB=550

# ─── VPS MULTI-BOT & PORT CONFIGURATION (ANTI-TABRAKAN) ───────────────────────
# Nama proses PM2 (Ganti jika menjalankan lebih dari 1 bot di VPS yang sama)
PM2_APP_NAME=discord-to-telegram-mirror
PM2_TUNNEL_NAME=nexus-dashboard-tunnel

# Port internal Web Dashboard (Ganti misal ke 5001, 5002 jika menjalankan banyak bot di 1 VPS)
PORT=5000
HEALTH_PORT=5000

# Aktifkan Web Dashboard (true/false)
ENABLE_WEB_SERVER=true

# Password keamanan Web Dashboard & REST API (SANGAT DIREKOMENDASIKAN!)
# Mengunci dashboard agar token dan kredensial bot tidak bisa diakses orang lain via URL publik tunnel
DASHBOARD_PASSWORD=admin123

# Pilihan Tunnel Provider: 'ngrok', 'localtunnel', atau 'cloudflare' (default: cloudflare)
TUNNEL_PROVIDER=ngrok

# Opsi 1: Ngrok Authtoken & Custom Domain (dapatkan gratis dari https://dashboard.ngrok.com)
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
# NGROK_DOMAIN=your-static-domain.ngrok-free.app

# Opsi 2: LocalTunnel (Subdomain custom)
# LOCALTUNNEL_SUBDOMAIN=nexus-dashboard-elit

# Opsi 3: Cloudflare Tunnel Token (jika pakai Cloudflare Zero Trust)
# TUNNEL_TOKEN=eyJh...



