# Batas RAM maksimal (MB) sebelum auto-restart (diatur 1500MB untuk AI Watermark Inpainting)
MAX_RAM_MB=1500

# ─── TELEGRAM BOTS ─────────────────────────────────────────────────────────────
# Tambahkan bot sebanyak yang dibutuhkan (TELEGRAM_BOT_1, TELEGRAM_BOT_2, dst)
TELEGRAM_BOT_1=8933930421:AAFna_Suk5tTtBqq5ybHrPQ8A0fgT-j_kEQ


# TELEGRAM_BOT_3=ISI_TOKEN_TELEGRAM_BOT_3
# ─── MAPPING CHANNEL ───────────────────────────────────────────────────────────
# Format: DISCORD_CHANNEL_ID:TELEGRAM_CHAT_ID:NOMOR_BOT_TG:THREAD_ID
# Nomor bot = angka di TELEGRAM_BOT_1, TELEGRAM_BOT_2, dst (Wajib diisi)
# THREAD_ID = ID Topic Telegram jika grup menggunakan fitur Topic/Forum (Opsional)
#
# Contoh:
#   Channel 1 → Bot TG 1
#   Channel 2 → Bot TG 2
#   Channel 3 → Bot TG 1  (ke topik/thread spesifik ID 5555)
#   Channel 4 → Bot TG 2  (ke topik/thread spesifik ID 8888)
#
# CHANNEL_MAPPING=CH1:TG_CHAT1:1,CH2:TG_CHAT2:2,CH3:TG_CHAT1:1:5555,CH4:TG_CHAT2:2:8888
CHANNEL_MAPPING=1494966942568550441:-1003991448470:1:94


# ─── BLOCK USER DISCORD ────────────────────────────────────────────────────────
# Pesan dari user ID ini tidak akan diteruskan ke Telegram
# Pisahkan dengan koma jika lebih dari satu ID
# Kosongkan jika tidak ingin memblok siapapun
BLOCKED_USER_IDS=

# ─── PENGATURAN UMUM ───────────────────────────────────────────────────────────
WATERMARK=🔄 MIRROR INDONESIA
FORWARD_BOT_MESSAGES=true
FORWARD_EDITS=true
SHOW_CHANNEL_NAME=false
SHOW_SERVER_NAME=false
SHOW_AUTHOR_NAME=true

# Kata yang diblacklist (pesan MENGANDUNG kata ini → tidak diteruskan)
BLACKLIST_WORDS=bodong

# Kata whitelist (pesan HARUS mengandung salah satu kata ini untuk diteruskan)
# Kosongkan = forward semua pesan (tanpa filter whitelist)
# Contoh: WHITELIST_WORDS=SIGNAL,BUY,SELL,PROMO
WHITELIST_WORDS=
# Panjang maksimum pesan (karakter)
MAX_MESSAGE_LENGTH=4000

# Delay antar pengiriman ke Telegram (ms) — jangan terlalu kecil
RATE_LIMIT_DELAY=200

# ─── ANTI-SPAM GODMODE ─────────────────────────────────────────────────────────
# Max gambar yang boleh dikirim satu user dalam satu window waktu
# Jika melebihi → dianggap flood spam → user diblok otomatis
SPAM_RATE_LIMIT=10

# Window waktu flood check (dalam milidetik). Default: 30000 = 30 detik
SPAM_FLOOD_WINDOW_MS=30000

# Threshold kemiripan gambar (Image Hash). 0-64. Makin kecil = makin ketat.
# Default 10: gambar mirip secara visual dalam 10 bit berbeda dari 64 bit hash
SPAM_HASH_THRESHOLD=7

# Aktifkan deteksi nomor HP/WA Indonesia (true/false). Default: true
SPAM_BLOCK_PHONE=false

# Aktifkan deteksi link Discord invite (true/false). Default: true
SPAM_BLOCK_DISCORD_INVITE=false

# Aktifkan deteksi link Telegram (true/false). Default: false (banyak false positive)
SPAM_BLOCK_TG_LINK=false

# Aktifkan deteksi kalimat promo (join sekarang, gabung gratis, dll). Default: true
SPAM_BLOCK_PROMO=false

# Aktifkan deteksi klaim mirror palsu (mirror bodong, asli hanya di, dll). Default: true
SPAM_BLOCK_FAKE_MIRROR=false

# Aktifkan deteksi pola nomor WA dalam format gambar/spasi. Default: true
SPAM_BLOCK_WA_PATTERN=false

# Aktifkan deteksi kata "bodong". Default: true
SPAM_BLOCK_BODONG=false


# ─── TELEGRAM ADMIN COMMANDS ───────────────────────────────────────────────────
# Telegram User ID Anda sebagai admin (cek via @userinfobot di Telegram)
ADMIN_TELEGRAM_ID=6356373334

# Nomor bot TG yang dipakai untuk menerima commands admin (default: 1)
ADMIN_BOT_KEY=1

# ─── WEB DASHBOARD & TUNNEL NGROK ──────────────────────────────────────────────
HEALTH_PORT=5000
ENABLE_WEB_SERVER=true

# Provider tunnel yang digunakan: ngrok / cloudflare / localtunnel
TUNNEL_PROVIDER=ngrok

# NGROK CONFIGURATION
# Dapatkan Auth Token gratis dari: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=3DcrnuGoCtmfeampSotE5jXAKDR_6Hrpik5fYXcLJksKCJFUZ

# Domain Ngrok Anda (Contoh: your-domain.ngrok-free.app atau domain dari ngrok dashboard)
# Kosongkan jika tidak memakai static domain
NGROK_DOMAIN=doorway-suffice-washboard.ngrok-free.dev


# ─── REACTION FORWARDING ───────────────────────────────────────────────────────
# Forward reaction emoji Discord ke Telegram sebagai reply pesan? (true/false)
# Contoh output: "👍 x3 — username"
FORWARD_REACTIONS=true

# ─── TELEGRAM TO DISCORD (TG→DC MIRROR) ────────────────────────────────────
# Aktifkan fitur mirror dari Telegram → Discord (true/false)
TG_TO_DC_ENABLED=true

# Forward pesan dari bot Telegram juga? (true/false)
TG_TO_DC_FORWARD_BOT_MESSAGES=false

# Mapping TG Chat → DC Webhook disimpan di: data/tg-to-dc-channels.json
# Gunakan command admin /addtg2dc atau Dashboard Web untuk mengelola mapping.
#
# Format JSON di tg-to-dc-channels.json:
# [
#   {
#     "name": "Nama Channel",
#     "tgChatId": "-1001234567890",     ← ID grup/channel Telegram (bisa negatif)
#     "tgThreadId": null,               ← Thread/Topic TG (null jika tidak pakai)
#     "botKey": "1",                    ← Tidak dipakai (untuk kompatibilitas)
#     "dcWebhookUrl": "https://discord.com/api/webhooks/ID/TOKEN"
#   }
# ]

# ─── TELEGRAM USER ACCOUNT (untuk TG→DC) ────────────────────────────────────
# Dapatkan API_ID dan API_HASH dari: https://my.telegram.org
# Login → App configuration → Buat / lihat app Anda
TG_API_ID=26182859
TG_API_HASH=e1a8dd753bfacaa2bdc711c1d4cfe1d1

# Session string akun Telegram biasa (BUKAN token bot!)
# Generate sekali dengan: node generate-tg-session.js
# Jika lebih dari 1 akun, pisahkan dengan koma:
# TG_USER_SESSIONS=session1,session2
TG_USER_

_deleteMissingTelegramBots=true
AUTO_DELETE_PHONE=false
AUTO_DELETE_DISCORD_INVITE=false
AUTO_DELETE_TG_LINK=false
AUTO_DELETE_PROMO=false
AUTO_DELETE_FAKE_MIRROR=false
AUTO_DELETE_WA_PATTERN=false
AUTO_DELETE_BODONG=false
AUTO_DELETE_BLACKLIST=false
AUTO_DELETE_HASH=false
DEBUG_OCR=false

# ─── AI WATERMARK & OCR SCANNER ──────────────────────────────────────────
# Set false untuk forward super cepat (instan tanpa delay AI scan/inpaint)
# Set true jika ingin watermark teks/logo dibersihkan otomatis dengan AI
ENABLE_AI_WATERMARK=false

# ─── DISCORD TO DISCORD (DC ➔ DC WEBHOOK) ──────────────────────────────────
# Aktifkan kutipan pesan reply (menampilkan konteks pesan yang dibalas)
DC_TO_DC_REPLY_QUOTE=true

# Hapus otomatis link invite Discord sumber (discord.gg / discord.com/invite)
DC_TO_DC_STRIP_INVITES=true

# Hanya teruskan jika pesan memiliki gambar/embed (abaikan obrolan teks biasa)
DC_TO_DC_ONLY_WITH_MEDIA=false

# Custom Whitelabeling (Kosongkan jika ingin memakai nama & avatar pengirim asli)
DC_TO_DC_CUSTOM_NAME=
DC_TO_DC_CUSTOM_AVATAR=

# Auto-Ping ke server tujuan (misal: @everyone, @here, atau <@&ROLE_ID>)
DC_TO_DC_AUTO_PING=